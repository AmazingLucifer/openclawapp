{
  "name": "openclaw-app",
  "version": "1.0.0",
  "description": "OpenClaw Desktop App - Beautiful AI Chat Client",
  "main": "electron/main.js",
  "scripts": {
    "dev": "npm run build:web && electron .",
    "build:web": "cd web && npm install && npm run build",
    "build": "npm run build:web && electron-builder --win",
    "build:dir": "npm run build:web && electron-builder --win --dir"
  },
  "keywords": ["openclaw", "electron", "ai", "chat"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "openclaw": "^2026.4.9"
  },
  "build": {
    "appId": "com.openclaw.app",
    "productName": "OpenClaw",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "electron/**/*",
      "web/dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "buildDependenciesFromSource": false,
    "npmRebuild": false
  }
}
